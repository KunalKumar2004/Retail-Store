<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Retail Store Management</title>
   <link rel="stylesheet" href="/css/style.css?v=1.1">
</head>
<body>
    <div class="container">
        <header class="header">
            <h1>💰 Inventory Value Report</h1>
            <p>Total inventory value: $<%= parseFloat(totalValue).toFixed(2) %></p>
            <nav style="margin-top: 20px;">
                <a href="/reports" class="btn btn-primary btn-sm">All Reports</a>
                <a href="/dashboard" class="btn btn-secondary btn-sm">Dashboard</a>
            </nav>
        </header>

        <div class="card">
            <div class="table-container">
                <table class="products-table">
                    <thead>
                        <tr>
                            <th>Product Name</th>
                            <th>Brand</th>
                            <th>Stock</th>
                            <th>Unit Price</th>
                            <th>Total Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(product => { %>
                            <tr>
                                <td><%= product.name %></td>
                                <td><%= product.brand %></td>
                                <td><%= product.stock %></td>
                                <td>$<%= parseFloat(product.unit_price).toFixed(2) %></td>
                                <td style="font-weight: bold;">$<%= parseFloat(product.total_value).toFixed(2) %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>