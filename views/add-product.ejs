<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Retail Store Management</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header class="header">
            <h1>🏪 Retail Store Management</h1>
            <p>Complete Inventory Management Solution</p>
            <nav style="margin-top: 20px;">
                <a href="/dashboard" class="btn btn-primary btn-sm">Dashboard</a>
                <a href="/products" class="btn btn-secondary btn-sm">Products</a>
                <a href="/products/add" class="btn btn-success btn-sm">Add Product</a>
            </nav>
        </header>

        <% if (typeof error !== 'undefined') { %>
            <div class="alert alert-error">
                <%= error %>
            </div>
        <% } %>

        <div class="card">
            <h2 style="margin-bottom: 30px;">
                <%= product ? '✏️ Edit Product' : '➕ Add New Product' %>
            </h2>
            
            <form action="/products/save" method="POST">
                <% if (product && product.id) { %>
                    <input type="hidden" name="id" value="<%= product.id %>">
                <% } %>
                
                <div class="form-group">
                    <label for="brand">Brand:</label>
                    <input type="text" id="brand" name="brand" class="form-control" 
                           value="<%= product ? product.brand : '' %>" placeholder="Enter brand name">
                </div>
                
                <div class="form-group">
                    <label for="name">Product Name: *</label>
                    <input type="text" id="name" name="name" class="form-control" 
                           value="<%= product ? product.name : '' %>" required placeholder="Enter product name">
                </div>
                
                <div class="form-group">
                    <label for="category">Category:</label>
                    <input type="text" id="category" name="category" class="form-control" 
                           value="<%= product ? product.category : '' %>" placeholder="Enter category">
                </div>
                
                <div class="form-group">
                    <label for="stock">Stock Quantity: *</label>
                    <input type="number" id="stock" name="stock" class="form-control" 
                           value="<%= product ? product.stock : 0 %>" required min="0">
                </div>
                
                <div class="form-group">
                    <label for="unit_price">Unit Price ($): *</label>
                    <input type="number" id="unit_price" name="unit_price" class="form-control" 
                           value="<%= product ? product.unit_price : 0 %>" required min="0" step="0.01">
                </div>
                
                <div class="form-group">
                    <label for="reorder_level">Reorder Level:</label>
                    <input type="number" id="reorder_level" name="reorder_level" class="form-control" 
                           value="<%= product ? product.reorder_level : 10 %>" min="0" placeholder="Low stock alert level">
                    <small style="color: #666;">Product will be marked as low stock when quantity reaches this level</small>
                </div>
                
                <div class="form-actions">
                    <button type="submit" class="btn btn-success">
                        <%= product ? '💾 Update Product' : '➕ Add Product' %>
                    </button>
                    <a href="/products" class="btn btn-primary">↩️ Cancel</a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>