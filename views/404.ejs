<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Retail Store Management</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="container">
        <header class="header">
            <h1>🏪 Retail Store Management</h1>
            <p>Complete Inventory Management Solution</p>
            <nav style="margin-top: 20px;">
                <a href="/dashboard" class="btn btn-primary btn-sm">Dashboard</a>
                <a href="/" class="btn btn-secondary btn-sm">Home</a>
            </nav>
        </header>

        <div class="card" style="text-align: center; padding: 50px;">
            <div style="font-size: 4rem; margin-bottom: 20px;">🔍</div>
            <h2 style="color: var(--warning); margin-bottom: 20px;">Page Not Found</h2>
            <p style="font-size: 1.2rem; margin-bottom: 30px; color: var(--gray);">
                The page you're looking for doesn't exist or has been moved.
            </p>

            <div style="display: flex; gap: 15px; justify-content: center; margin-top: 30px;">
                <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
                <a href="/products" class="btn btn-secondary">View Products</a>
                <button onclick="window.history.back()" class="btn btn-warning">Go Back</button>
            </div>
        </div>
    </div>
</body>
</html>
